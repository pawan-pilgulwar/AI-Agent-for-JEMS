							"raw": "{\n  \"request_type\": \"generate_assessment\",\n  \"payload\": {\n    \"user_id\": \"{{studentId}}\",\n    \"skills\": [\"python\", \"fastapi\"],\n    \"role_category\": \"backend engineering\",\n    \"difficulty\": \"{{testDifficulty}}\",\n    \"num_questions\": 3\n  }\n}",
