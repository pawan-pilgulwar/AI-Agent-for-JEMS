# Ollama / LiteLLM (local, free LLM inference or hosted provider)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:30b
FAST_LLM_MODEL=llama3.2:1b
REASONING_LLM_MODEL=qwen3:30b

# Embeddings (local, free, CPU-only)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# MongoDB Atlas (same cluster and database used by the main Jems platform)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=jems

# Atlas Vector Search index names (created once via Atlas UI/Admin API)
VECTOR_INDEX_NAME=candidate_embeddings_index
VECTOR_INDEX_NAME_REGISTERED_COMPANIES=registered_companies_vector_index
VECTOR_INDEX_NAME_REGISTERED_JOBS=registered_jobs_vector_index
VECTOR_INDEX_NAME_SCRAPED_COMPANIES=scraped_companies_vector_index
VECTOR_INDEX_NAME_SCRAPED_JOBS=scraped_jobs_vector_index

# Legacy collection indexes (backward-compatible)
VECTOR_INDEX_NAME_COMPANIES=companies_vector_index
VECTOR_INDEX_NAME_JOBS=job_postings_vector_index

# Search and scraping configs
MATCH_TOP_N=10
RAG_TOP_K=5
SCRAPE_RATE_LIMIT_SECONDS=2
SCRAPE_USER_AGENT=JemsBot/1.0 (+https://jems.exponentor.com/bot-info)

