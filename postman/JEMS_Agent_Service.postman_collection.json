			"item": [
				{
					"name": "Service Health Check",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Verify baseUrl is configured in the environment",
									"if (!pm.environment.get(\"baseUrl\")) {",
									"    pm.environment.set(\"baseUrl\", \"http://localhost:8000\");",
									"}"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Service is healthy\", function () {",
									"    var data = pm.response.json();",
									"    pm.expect(data.status).to.eql(\"ok\");",
									"    pm.expect(data.service).to.eql(\"jems-agent-service\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Checks liveness and version of the JEMS AI microservice."
					},
					"response": []
				}
			]
		},
		{
			"name": "1. Central Multi-Agent Orchestrator (/orchestrate)",
			"description": "The central router that receives requests with a `request_type` envelope and dynamically routes them to the appropriate agent crew or pipeline using environment variables.",
			"item": [
				{
					"name": "1.1 Full Student Pipeline (E2E Workflow)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Ensure required dynamic environment variables exist",
									"if (!pm.environment.get(\"studentId\")) pm.environment.set(\"studentId\", \"stud-101\");",
									"if (!pm.environment.get(\"careerObjective\")) pm.environment.set(\"careerObjective\", \"Backend Software Developer\");",
									"if (!pm.environment.get(\"targetRole\")) pm.environment.set(\"targetRole\", \"Backend Engineer\");",
									"if (!pm.environment.get(\"studentSkills\")) pm.environment.set(\"studentSkills\", '[\"Python\", \"SQL\", \"Git\"]');",
									"if (!pm.environment.get(\"targetCompanies\")) pm.environment.set(\"targetCompanies\", '[\"Capgemini\", \"TCS\"]');"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"E2E Pipeline executed successfully\", function () {",
									"    var data = pm.response.json();",
									"    pm.expect(data.status).to.eql(\"success\");",
									"    pm.expect(data.result).to.have.property(\"analysis\");",
									"    pm.expect(data.result).to.have.property(\"roadmap\");",
									"    pm.expect(data.result).to.have.property(\"learning_recommendations\");",
									"    pm.expect(data.result).to.have.property(\"suggested_jobs\");",
									"    ",
									"    // Dynamically store skill gaps extracted by the pipeline",
									"    if (data.result.analysis.technical_skill_gaps) {",
									"        pm.environment.set(\"discoveredSkillGaps\", JSON.stringify(data.result.analysis.technical_skill_gaps));",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"request_type\": \"full_student_pipeline\",\n  \"payload\": {\n    \"student_profile\": {\n      \"user_id\": \"{{studentId}}\",\n      \"name\": \"{{studentName}}\",\n      \"skills\": {{studentSkills}},\n      \"education\": \"B.Tech Computer Science\"\n    },\n    \"resume_text\": \"{{resumeText}}\",\n    \"career_objective\": \"{{careerObjective}}\",\n    \"target_role\": \"{{targetRole}}\",\n    \"target_companies\": {{targetCompanies}},\n    \"timeline_weeks\": {{timelineWeeks}}\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/orchestrate",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"orchestrate"
							]
						},
						"description": "Executes the full pipeline dynamically: Analysis ➔ Roadmap ➔ Learning ➔ Job Matching."
					},
					"response": []
				},
				{
					"name": "1.2 Orchestrate: Analyze Profile (Agent 1)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Ensure required dynamic values",
									"if (!pm.environment.get(\"studentId\")) pm.environment.set(\"studentId\", \"stud-101\");",
									"if (!pm.environment.get(\"studentSkills\")) pm.environment.set(\"studentSkills\", '[\"Python\", \"SQL\", \"Git\"]');"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Profile analyzed dynamically\", function () {",
									"    var res = pm.response.json().result;",
									"    pm.expect(res).to.have.property(\"student_skills\");",
									"    pm.expect(res).to.have.property(\"technical_skill_gaps\");",
									"    pm.expect(res).to.have.property(\"compatibility_score\");",
									"    ",
									"    // Dynamically chain discovered gaps to environment for roadmap & learning agents",
									"    if (res.technical_skill_gaps && res.technical_skill_gaps.length > 0) {",
									"        pm.environment.set(\"discoveredSkillGaps\", JSON.stringify(res.technical_skill_gaps));",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"request_type\": \"analyze_profile\",\n  \"payload\": {\n    \"student_profile\": {\n      \"user_id\": \"{{studentId}}\",\n      \"name\": \"{{studentName}}\",\n      \"skills\": {{studentSkills}}\n    },\n    \"resume_text\": \"{{resumeText}}\",\n    \"career_objective\": \"{{careerObjective}}\",\n    \"target_companies\": {{targetCompanies}},\n    \"target_role\": \"{{targetRole}}\"\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
