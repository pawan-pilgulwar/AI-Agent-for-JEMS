# Ollama (local, free LLM inference)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

# Embeddings (local, free, CPU-only)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# MongoDB Atlas (same cluster used by the main Jems platform)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=jems

# Atlas Vector Search index name (created once via Atlas UI/Admin API — see README)
VECTOR_INDEX_NAME=candidate_embeddings_index

# Stage-1 vector search result size fed into Stage-2 LLM reasoning
MATCH_TOP_N=10

# RAG grounding: how many real documents to retrieve per query
RAG_TOP_K=5

# Company Intelligence Agent scraping (tools/web_scraper_tool.py)
SCRAPE_RATE_LIMIT_SECONDS=2
SCRAPE_USER_AGENT=JemsBot/1.0 (+https://jems.exponentor.com/bot-info)

# Atlas Vector Search index names for the two new collections (created once --
# see README) -- separate indexes because each Atlas Vector Search index is
# scoped to a single collection
VECTOR_INDEX_NAME_COMPANIES=companies_vector_index
VECTOR_INDEX_NAME_JOBS=job_postings_vector_index
