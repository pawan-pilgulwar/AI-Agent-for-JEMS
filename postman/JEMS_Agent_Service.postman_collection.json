					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"if (!pm.environment.get(\"testDifficulty\")) pm.environment.set(\"testDifficulty\", \"intermediate\");"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Assessment test generated and saved to environment\", function () {",
									"    var res = pm.response.json().result;",
									"    pm.expect(res).to.have.property(\"test_id\");",
									"    pm.expect(res).to.have.property(\"questions\");",
									"    ",
									"    // Dynamically set currentTestId and question ID for evaluation",
									"    pm.environment.set(\"currentTestId\", res.test_id);",
									"    if (res.questions && res.questions.length > 0) {",
									"        pm.environment.set(\"assessmentQuestionId\", res.questions[0].question_id.toString());",
									"        if (res.questions[0].correct_answer) {",
									"            pm.environment.set(\"assessmentAnswer\", res.questions[0].correct_answer);",
									"        }",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
