# Copy to `.env` (or `.env.local`) and fill in the values.

# ── Core ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
AUTH_SECRET=change-me-to-a-long-random-string
# Public base URL of this app (used for share links and auth callbacks).
AUTH_URL=http://localhost:3000
# GitHub OAuth (optional — only needed for "Continue with GitHub").
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Redis for rate limiting (optional — falls back to in-memory limits).
REDIS_URL=redis://localhost:6379

# ── Email (OTP, password reset) ───────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Jems <no-reply@example.com>"
STUDENT_EMAIL_DOMAINS=
FACULTY_SIGNUP_CODE=

# ── Roadmap lesson narration (optional; deterministic fallback otherwise)
GEMINI_API_KEY=
GEMINI_MODEL=

# ── AI Agent service (Agent/ folder, FastAPI "analyzer") ──────────────
# Base URL of the Agent API. Local docker compose exposes it on :8080.
# Replace with the hosted URL when the Agent is deployed (no trailing slash).
AGENT_BASE_URL=http://localhost:8080
# Optional shared secret sent as "Authorization: Bearer <key>" if the hosted
# Agent is put behind an auth proxy. Leave empty for local development.
AGENT_API_KEY=
# Per-request timeout for Agent calls (the Agent can take up to 300 s).
AGENT_TIMEOUT_MS=300000
# /agents/roadmap only: it makes dozens of rate-limited LLM calls, ~570 s measured (keep within the roadmap route's 800 s maxDuration)
AGENT_ROADMAP_TIMEOUT_MS=750000
# How many AI tasks one server process runs at the same time.
AI_TASK_CONCURRENCY=3

# Optional: GitHub token used when reading a student's public repos for the
# coding-profile analysis (raises GitHub's rate limit from 60 to 5000/hour).
GITHUB_TOKEN=
