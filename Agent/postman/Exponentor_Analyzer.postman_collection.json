        {
          "name": "Prerequisites (prereqs agent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/agents/prereqs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "agents",
                "prereqs"
              ]
            },
            "description": "Company skills -> prerequisite tree. Uses `companySkills`. Saves `prereqTree`, `targetSkill`, `missingSkills`, `assessmentSkill`, `assessmentTopics` from the first skill. 15-60 s per skill.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skills\": {{json_companySkills}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code !== 200) return;",
                  "const data = pm.response.json();",
                  "const first = (data.skills || [])[0];",
                  "pm.test(\"Got a prerequisite tree\", function () {",
                  "    pm.expect(first, \"no skills in response\").to.be.an(\"object\");",
                  "    pm.expect(first.prerequisites).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "if (!first || !(first.prerequisites || []).length) return;",
                  "",
                  "const prereqs = first.prerequisites;",
                  "pm.environment.set(\"prereqTree\", JSON.stringify(data.skills));",
                  "pm.environment.set(\"targetSkill\", first.skill);",
                  "pm.environment.set(\"missingSkills\", JSON.stringify(prereqs.map(function (p) { return p.name; })));",
                  "// The first prerequisite is the foundation, so it is the first skill to assess.",
                  "pm.environment.set(\"assessmentSkill\", prereqs[0].name);",
                  "pm.environment.set(\"assessmentTopics\", JSON.stringify(prereqs[0].topics || []));",
                  "",
                  "if (first.warnings) console.warn(\"Prerequisite tree has warnings:\", first.warnings);",
                  "console.log(\"Saved targetSkill, missingSkills, assessmentSkill, assessmentTopics from \" + first.skill);"
                ]
              }
            }
          ]
        },
